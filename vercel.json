    },
    {
      "source": "/product/natural-rose-quartz-shree-yantra",
      "destination": "/product/crystal-shree-yantra",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/index-:hash.css",
      "destination": "/assets/index.css"
    },
    {
      "source": "/assets/vendor-swiper-:hash.css",
      "destination": "/assets/vendor-swiper.css"
    },
    {
      "source": "/((?!images/|assets/|favicon|products/detail|product/detail|contents|wp-content|wp-includes|wp-admin|information|CSFTop|renga|product-category|product-tag|hg|shop/userreview|shop/storeSearch|.*\\.(?:webp|jpg|jpeg|png|svg|ico|txt|xml|json|tsv|html)).*)",
      "destination": "/index.html"
    }
  ]
}