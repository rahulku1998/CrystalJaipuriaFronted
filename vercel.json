    },
    {
      "source": "/product/rose-quartz-mahaveer",
      "destination": "/product/rose-quartz-bhagwan-mahaveer-statue",
      "permanent": true
    },
    {
      "source": "/product/lapis-lazuli-shivlnga/:path*",
      "destination": "/product/lapis-lazuli-gemstone-shiva-linga-with-face-of-shiva",
      "permanent": true
    },
    {
      "source": "/product/lapis-lazuli-shivlnga",
      "destination": "/product/lapis-lazuli-gemstone-shiva-linga-with-face-of-shiva",
      "permanent": true
    },
    {
      "source": "/product/natural-rose-quartz-shree-yantra/:path*",
